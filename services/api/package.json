{
  "name": "@prompttoppt/api",
  "version": "0.0.1",
  "private": true,
  "description": "Hono API server — REST endpoints for promptToPpt",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "clean": "rimraf dist",
    "ai:check": "tsx --env-file-if-exists=.env scripts/ai-check.ts",
    "catalog:vertex": "tsx --env-file-if-exists=.env scripts/catalog-vertex-prices.ts",
    "catalog:sync": "tsx --env-file-if-exists=.env scripts/catalog-sync.ts",
    "make-admin": "tsx --env-file-if-exists=.env scripts/make-admin.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "billing:sync-plans": "tsx --env-file-if-exists=.env scripts/billing-sync-plans.ts",
    "pricing:model": "tsx --env-file-if-exists=.env scripts/pricing-model.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@mozilla/readability": "^0.6.0",
    "@prompttoppt/ai": "workspace:*",
    "@prompttoppt/theme": "workspace:*",
    "@prompttoppt/types": "workspace:*",
    "@prompttoppt/validation": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.1.0",
    "hono": "^4.13.12",
    "linkedom": "^0.18.13",
    "nanoid": "^6.0.1",
    "pg": "^8.23.1",
    "pino": "^9.3.0",
    "pptxgenjs": "^4.0.1",
    "undici": "^8.11.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "rimraf": "^5.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
