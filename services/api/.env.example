# ─── promptToPpt — API Server Environment Variables ────────────────────
# Copy this to .env and fill in values

# App
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
ALLOWED_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://prompttoppt:prompttoppt_dev_password@localhost:5432/prompttoppt_dev

# Redis
REDIS_URL=redis://localhost:6379

# AWS (for S3 file storage — optional in dev, use local mocks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_PRIVATE=prompttoppt-dev-private
S3_BUCKET_PUBLIC=prompttoppt-dev-public

# Auth (Better Auth)
AUTH_SECRET=change-me-to-a-random-32-char-secret
AUTH_URL=http://localhost:4000

# Google OAuth (optional for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI — Development
GEMINI_API_KEY=

# AI — Production (OpenRouter)
OPENROUTER_API_KEY=

# Billing — India
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Billing — International
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=

# AWS SQS (for generation jobs)
SQS_GENERATION_QUEUE_URL=
