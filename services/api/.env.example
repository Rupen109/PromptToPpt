# ─── promptToPpt API — copy to .env (gitignored) ────────────────────────
NODE_ENV=development
PORT=4000

# Public URLs. In production: API_URL=https://api.prompttoppt.app, WEB_URL=https://prompttoppt.app,
# EDITOR_URL=https://app.prompttoppt.app, COOKIE_DOMAIN=.prompttoppt.app
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
EDITOR_URL=http://localhost:3001
# Leave empty locally (cookies are shared across localhost ports). Set to the parent domain in prod.
COOKIE_DOMAIN=

# Number of proxies we control in front of the API (ALB=1, CloudFront+ALB=2, none=0). Used for rate-limit IPs.
TRUSTED_PROXY_HOPS=0

DATABASE_URL=postgresql://prompttoppt:prompttoppt_dev_password@localhost:5432/prompttoppt_dev

# Generate with: openssl rand -base64 32  (must be >= 32 chars; never reuse across environments)
AUTH_SECRET=

# Social login (optional until you create OAuth credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (Phase 2)
GEMINI_API_KEY=
# Production catalogue provider (https://openrouter.ai/keys). Required when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Which backend serves the model catalogue (the DB table `model_catalog` says which models exist & who may use them):
#   gemini = AI Studio key | vertex = Vertex AI express key (local dev) | openrouter = production | mock = deterministic fake
AI_PROVIDER=gemini
APP_ENV=development

# Server-side limits (replaced by plan limits in the billing phase)
GENERATION_DAILY_LIMIT=20
# Run the generation worker inside the API process. Set false when running services/worker separately.
RUN_WORKER=true

# ── Razorpay (https://dashboard.razorpay.com → Test Mode → Settings → API Keys) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; enter the SAME value in Dashboard → Settings → Webhooks (URL: <API_URL>/api/v1/webhooks/razorpay,
# events: subscription.* and payment.failed). Generate with: openssl rand -hex 24
RAZORPAY_WEBHOOK_SECRET=
# true once Razorpay international payments are enabled on the account (allows USD checkout)
RAZORPAY_INTERNATIONAL=false
# Dev/testing only: force the billing currency (INR | USD) instead of detecting it from the visitor's country
BILLING_FORCE_CURRENCY=

# ── AI pictures ──
# Where generated pictures are stored. local = ./.data/assets (dev only). Production MUST use s3 (private bucket; served through the API).
ASSET_STORAGE=local
ASSET_DIR=.data/assets
ASSET_BUCKET=
ASSET_REGION=
# Kill switch for all picture generation (cost control): set false to stop instantly without a deploy of code
IMAGES_ENABLED=true

# ── Relevant pictures for generated decks (free key from https://www.pexels.com/api/) ──
# Without it only the small tagged library is searched, so most picture slides stay clean text slides (a missing picture beats a wrong one).
PEXELS_API_KEY=
# ── Google Cloud spend tracking (see docs/GOOGLE_CLOUD_BILLING.md) ──
# GCP_BILLING_EXPORT_TABLE=
# GCP_SERVICE_ACCOUNT_JSON=
# Unsplash (preferred stock source): the "Access Key" of your app at https://unsplash.com/developers (the secret key is not needed)
UNSPLASH_ACCESS_KEY=

# ── account abuse protection (see docs/SECURITY_PLAN.md) ──
# Production REQUIRES: REQUIRE_EMAIL_VERIFICATION=true, RESEND_API_KEY, EMAIL_FROM, APP_ENV, TRUSTED_PROXY_HOPS>=1
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM=
# Cloudflare Turnstile secret (site key goes in apps/web NEXT_PUBLIC_TURNSTILE_SITE_KEY); enables the CAPTCHA on sign-up and after repeated sign-in failures
TURNSTILE_SECRET_KEY=
EXTRA_BLOCKED_EMAIL_DOMAINS=

# ── AI spend circuit breaker (USD, rolling windows, from the usage ledger). Tune to your real budget; heavy local testing can reach these ──
AI_BUDGET_USD_HOUR=15
AI_BUDGET_USD_DAY=75
AI_USER_USD_DAY=6
