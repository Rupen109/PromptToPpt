# HTTPS certificates come from Let's Encrypt automatically once the domain points at this server.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
app.{$DOMAIN} {
	encode zstd gzip
	root * /srv/editor
	# a single-page app: unknown paths are the app itself; hashed files are cached for a year, the entry page never
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
