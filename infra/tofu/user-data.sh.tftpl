#!/bin/bash
# Prepares the server once, at first boot: swap (the server has only 1 GB of memory), Docker, Docker Compose, a folder for the app.
set -euxo pipefail
exec > >(tee /var/log/slidesdone-bootstrap.log) 2>&1

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  echo 'vm.swappiness=20' > /etc/sysctl.d/99-swap.conf && sysctl -p /etc/sysctl.d/99-swap.conf
fi

dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-aarch64" -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
usermod -aG docker ssm-user || true

mkdir -p /opt/slidesdone
cat > /opt/slidesdone/config.env <<CFG
ENVNAME=${env}
AWS_REGION=${region}
ASSETS_BUCKET=${assets_bucket}
CFG
echo bootstrap-done > /opt/slidesdone/.bootstrapped
