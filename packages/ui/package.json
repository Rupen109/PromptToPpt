{
  "name": "@prompttoppt/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared presentation renderer (slides, charts, animation runtime) used by the editor, the website and the share viewer",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logo": "./src/Logo.tsx",
    "./icons": "./src/icons.ts",
    "./markdown": "./src/Markdown.tsx",
    "./prose.css": "./src/prose.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prompttoppt/theme": "workspace:*",
    "@prompttoppt/validation": "workspace:*",
    "lucide-react": "0.468.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.3.1",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  }
}
