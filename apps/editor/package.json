{
  "name": "@prompttoppt/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "React presentation editor — app.<domain>",
  "scripts": {
    "dev": "vite --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prompttoppt/api-client": "workspace:*",
    "@prompttoppt/theme": "workspace:*",
    "@prompttoppt/ui": "workspace:*",
    "@prompttoppt/validation": "workspace:*",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
